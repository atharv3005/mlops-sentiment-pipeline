[core]
    remote = localstorage

['remote "localstorage"']
    url = ../dvc-storage

# To use real remote storage instead (recommended once you swap in a full
# dataset like IMDB/Yelp so `git clone` stays lightweight):
#
#   S3 (free tier eligible):
#     dvc remote add -d storage s3://your-bucket-name/dvc-store
#     dvc remote modify storage region ap-south-1
#
#   Google Drive (fully free, no AWS account needed):
#     dvc remote add -d storage gdrive://<folder-id>
#
# Then: dvc push   (uploads data)  /  dvc pull (downloads data on a fresh clone)
